#!/usr/bin/env bash
# hyperblue - per-user setup, update and repair for the Hyperblue image.
#
# Everything that can be baked into the image (desktop packages, configuration
# files, systemd units) is installed at build time. This command only performs
# work that cannot happen during the image build: per-user, first-login
# integration steps that live in /usr/libexec/hyperblue/setup.d.
#
# Steps are idempotent, ordered by filename, and tracked in
# $XDG_STATE_HOME/hyperblue/setup so a failed run is retried and a finished one
# is never repeated. A step that needs network declares it in its header:
#
#   # hyperblue:needs-network

set -uo pipefail

CLI_VERSION="1.0.0"
STEP_DIR="${HYPERBLUE_STEP_DIR:-/usr/libexec/hyperblue/setup.d}"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/hyperblue"
SETUP_STATE="$STATE_ROOT/setup"
COMPLETE_MARKER="$SETUP_STATE/.complete"
NET_TIMEOUT="${HYPERBLUE_NET_TIMEOUT:-180}"
NET_PROBE_URL="${HYPERBLUE_NET_PROBE_URL:-https://fedoraproject.org/static/hotspot.txt}"

# Per-user install target for `hyperblue install`. ~/.local/bin is on PATH for
# login shells on Fedora, and ~/.local/share/lite-xl is picked up automatically
# by a Lite XL binary living in ~/.local/bin.
INSTALL_ROOT="${HYPERBLUE_INSTALL_ROOT:-$HOME/.local}"
BIN_DIR="$INSTALL_ROOT/bin"
LITE_XL_DATA="$INSTALL_ROOT/share/lite-xl"
LITE_XL_REPO="lite-xl/lite-xl"
UV_VERSION="0.13.6"
BUN_VERSION="1.4.4"
DENO_VERSION="2.9.8"
FNM_VERSION="1.39.0"
PYENV_VERSION="v2.8.14"
LUAVER_VERSION="v1.1.0"
LUAVER_URL="https://raw.githubusercontent.com/DhavalKapil/luaver/$LUAVER_VERSION"
LUAVER_SHA256="5b0bff3f7ce4607ad3a271034f778511aee7070ce48939e42a6579982c68e20f"
LUAVER_COMPLETIONS_SHA256="3929a3d2db48f4b0f8ecc9fe4a354ec07314960f5bec428c1e44ed873271e25f"

# EX_TEMPFAIL: transient condition (no network yet); the caller should retry.
EX_TEMPFAIL=75

if [[ -t 1 ]]; then
    BOLD=$'\e[1m' RED=$'\e[31m' YELLOW=$'\e[33m' GREEN=$'\e[32m' NORMAL=$'\e[0m'
else
    BOLD='' RED='' YELLOW='' GREEN='' NORMAL=''
fi

info() { printf '%s\n' "$*"; }
warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$NORMAL" >&2; }
err() { printf '%s%s%s\n' "$RED" "$*" "$NORMAL" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<EOF
${BOLD}hyperblue${NORMAL} ${CLI_VERSION} - Hyperblue per-user setup and maintenance

Usage: hyperblue <command> [options]

Commands:
  setup            Run pending first-run setup steps (run once per user)
  update           Re-run steps after the image was updated or rebased
  fix [--only S]   Re-run setup steps even if they are already recorded as done
  install [NAME..] Install per-user developer tools into ~/.local (see below)
  status           Show image version, setup state and step results
  version          Show the image and CLI version
  help             Show this help

Options for setup/update/fix:
  --auto             Non-interactive; do nothing if setup already completed
  --force            Re-run the selected steps regardless of recorded state
  --only STEP        Limit the run to a single step (prefix match)
  --list             List available setup steps and exit
  --no-wait          Do not wait for network connectivity before running
  -h, --help         Show this help

Options for install:
  --list             List the tools this command can install
  lite-xl            Lite XL editor in ~/.local/share/lite-xl, on PATH via
                     ~/.local/bin, plugin manager (lpm) registration included
  uv                 Astral's Python toolchain
  bun                Bun JavaScript runtime
  deno               Deno runtime
  fnm                Fast Node Manager
  pyenv              Python version manager, with pyenv-virtualenv
  luaver             Lua/LuaJIT/LuaRocks version manager
  With no NAME, every tool above is installed. Installed tools are skipped.

State lives in \$XDG_STATE_HOME/hyperblue (default ~/.local/state/hyperblue).
Steps live in $STEP_DIR.

Everything else ships inside the image: Hyprland, Noctalia, the SDDM
greeter and Bluefin's Waydroid integration all come preinstalled. Waydroid is
initialised explicitly with 'ujust setup-waydroid', not from this command.
EOF
}

image_version() {
    local value=''
    if [[ -r /usr/lib/os-release ]]; then
        value="$(set +u; . /usr/lib/os-release >/dev/null 2>&1; printf '%s' "${IMAGE_VERSION:-${VERSION_ID:-unknown}}")"
    fi
    printf '%s' "${value:-unknown}"
}

network_available() {
    if have curl; then
        curl -fsS --max-time 10 -o /dev/null "$NET_PROBE_URL" 2>/dev/null
        return
    fi
    if have nm-online; then
        nm-online -q -t 10 >/dev/null 2>&1
        return
    fi
    # No way to probe: assume connectivity rather than blocking forever.
    return 0
}

wait_for_network() {
    local deadline=$((SECONDS + NET_TIMEOUT))
    info "Waiting for network connectivity (up to ${NET_TIMEOUT}s)..."
    while ((SECONDS < deadline)); do
        network_available && return 0
        sleep 5
    done
    return 1
}

list_steps() {
    [[ -d $STEP_DIR ]] || return 0
    find "$STEP_DIR" -maxdepth 1 -type f -name '[0-9]*-*' -printf '%f\n' 2>/dev/null | sort
}

step_needs_network() {
    grep -qi '^# *hyperblue:needs-network' "$STEP_DIR/$1" 2>/dev/null
}

step_state() {
    local file="$SETUP_STATE/$1.state"
    [[ -r $file ]] && head -n 1 "$file"
}

step_status() {
    local state
    state="$(step_state "$1")"
    printf '%s' "${state%% *}"
}

step_done() { [[ "$(step_status "$1")" == ok ]]; }

step_current() {
    local state status recorded
    state="$(step_state "$1")"
    [[ -n $state ]] || return 1
    read -r status recorded _ <<<"$state"
    [[ $status == ok && $recorded == "$(image_version)" ]]
}

record_step() {
    local step=$1 status=$2
    mkdir -p "$SETUP_STATE" || return 1
    printf '%s %s %s\n' "$status" "$(image_version)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        >"$SETUP_STATE/$step.state.tmp" && mv -f "$SETUP_STATE/$step.state.tmp" "$SETUP_STATE/$step.state"
}

run_step() {
    local step=$1 path="$STEP_DIR/$1"
    info "${BOLD}==> ${step}${NORMAL}"
    [[ -f $path ]] || { err "missing setup step: $path"; return 1; }
    if [[ -x $path ]]; then
        "$path"
    else
        bash "$path"
    fi
}

# setup_run MODE [options]   where MODE is "once", "revalidate" or "force"
setup_run() {
    local mode=$1
    shift
    local auto=0 wait_net=1 only=''

    while (($#)); do
        case $1 in
            --auto) auto=1 ;;
            --force) mode=force ;;
            --only)
                shift
                only=${1:-}
                [[ -n $only ]] || { err "--only requires a step name"; return 2; }
                ;;
            --list) list_steps; return 0 ;;
            --no-wait|--no-network-wait) wait_net=0 ;;
            -h|--help) usage; return 0 ;;
            *) err "unknown option: $1"; return 2 ;;
        esac
        shift
    done

    mkdir -p "$SETUP_STATE"

    local pending=() step
    while IFS= read -r step; do
        [[ -n $step ]] || continue
        [[ -n $only && $step != "$only"* ]] && continue
        case $mode in
            force) pending+=("$step") ;;
            revalidate) step_current "$step" || pending+=("$step") ;;
            *) step_done "$step" || pending+=("$step") ;;
        esac
    done < <(list_steps)

    if ((${#pending[@]} == 0)); then
        ((auto)) && [[ -f $COMPLETE_MARKER ]] && return 0
        info "Nothing to do."
        touch "$COMPLETE_MARKER"
        return 0
    fi

    local needs_network=0
    for step in "${pending[@]}"; do
        step_needs_network "$step" && needs_network=1
    done

    if ((needs_network && wait_net)); then
        if ! wait_for_network; then
            warn "No network connectivity; will retry later."
            rm -f "$COMPLETE_MARKER"
            return $EX_TEMPFAIL
        fi
    fi

    local failed=0
    for step in "${pending[@]}"; do
        if run_step "$step"; then
            record_step "$step" ok
        else
            local rc=$?
            err "step failed: $step (exit $rc)"
            record_step "$step" failed
            failed=1
        fi
    done

    if ((failed)); then
        rm -f "$COMPLETE_MARKER"
        return 1
    fi

    touch "$COMPLETE_MARKER"
    info "${GREEN}Setup complete.${NORMAL}"
    return 0
}

cmd_setup() { setup_run once "$@"; }
cmd_update() { setup_run revalidate "$@"; }

cmd_fix() {
    rm -f "$SETUP_STATE"/*.state "$COMPLETE_MARKER" 2>/dev/null
    setup_run force "$@"
}

## Per-user tool installation ------------------------------------------------
#
# Everything here writes under ~/.local and is safe to re-run: a tool that is
# already present is skipped. Digests come from the checksum file each project
# publishes next to its release, so a moved or compromised artifact fails
# instead of installing. lite-xl and fnm publish none; those pin a version and
# trust the HTTPS download.

machine_arch() {
    case "$(uname -m)" in
        x86_64) printf 'x86_64' ;;
        aarch64) printf 'aarch64' ;;
        *) return 1 ;;
    esac
}

# SHA-256 of <tool> for <arch>, copied verbatim from the release's checksum
# file. Returns 1 when the project publishes no digest.
release_digest() {
    case "$1/$2" in
        uv/x86_64) printf '%s' 'f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645' ;;
        uv/aarch64) printf '%s' '229e194255c7958d86d56e8790d969a6f74736592133f0dfd0076f754c642c1d' ;;
        bun/x86_64) printf '%s' 'bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c' ;;
        bun/aarch64) printf '%s' 'baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e' ;;
        deno/x86_64) printf '%s' 'e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609' ;;
        deno/aarch64) printf '%s' 'd49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905' ;;
        *) return 1 ;;
    esac
}

# Download <url> into <dest>, checking it against <tool>'s published digest for
# <arch>. Falls back to the download alone when upstream publishes none.
fetch_release() {
    local tool=$1 arch=$2 url=$3 dest=$4 sha256
    if sha256=$(release_digest "$tool" "$arch"); then
        fetch_verified "$url" "$sha256" "$dest"
    else
        curl -fsSL --retry 3 --retry-delay 5 -o "$dest" "$url" || {
            err "download failed: $url"
            return 1
        }
    fi
}

fetch_verified() {
    local url=$1 sha256=$2 dest=$3
    if ! curl -fsSL --retry 3 --retry-delay 5 -o "$dest" "$url"; then
        err "download failed: $url"
        return 1
    fi
    if ! printf '%s  %s\n' "$sha256" "$dest" | sha256sum -c --quiet -; then
        err "checksum mismatch for $url"
        return 1
    fi
}

install_lite_xl() (
    local arch version url tmp
    arch=$(machine_arch) || { err "lite-xl: unsupported architecture"; return 1; }

    if [[ -x $BIN_DIR/lite-xl && -r $LITE_XL_DATA/data/core/start.lua ]]; then
        info "lite-xl: already installed in $LITE_XL_DATA"
        return 0
    fi

    if ! have jq; then
        err "lite-xl: jq is required to resolve the latest release"
        return 1
    fi
    version=$(curl -fsSL "https://api.github.com/repos/$LITE_XL_REPO/releases/latest" |
        jq -r '.tag_name // empty') || version=''
    if [[ -z $version ]]; then
        err "lite-xl: could not determine the latest release"
        return 1
    fi
    version=${version#v}

    # The portable tarball carries the binary plus its data directory, and is
    # the only asset GitHub publishes that lpm can consume for every arch.
    url="https://github.com/$LITE_XL_REPO/releases/download/v$version/lite-xl-v$version-addons-linux-$arch-portable.tar.gz"

    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT
    info "lite-xl: downloading $version"
    if ! curl -fsSL --retry 3 --retry-delay 5 -o "$tmp/lite-xl.tar.gz" "$url"; then
        err "lite-xl: download failed: $url"
        return 1
    fi

    mkdir -p "$LITE_XL_DATA" || return 1
    if ! tar -xzf "$tmp/lite-xl.tar.gz" -C "$tmp"; then
        err "lite-xl: could not extract $url"
        return 1
    fi
    # Keep the portable layout: <share>/lite-xl/lite-xl next to <share>/lite-xl/data,
    # which is where a binary in <prefix>/bin looks for its data directory.
    cp -a "$tmp/lite-xl/data" "$LITE_XL_DATA/data" ||
        { err "lite-xl: could not write $LITE_XL_DATA/data"; return 1; }
    install -D -m 0755 "$tmp/lite-xl/lite-xl" "$LITE_XL_DATA/lite-xl" ||
        { err "lite-xl: could not write $LITE_XL_DATA/lite-xl"; return 1; }

    mkdir -p "$BIN_DIR" || return 1
    ln -sfn "$LITE_XL_DATA/lite-xl" "$BIN_DIR/lite-xl" ||
        { err "lite-xl: could not link $BIN_DIR/lite-xl"; return 1; }

    if have lpm; then
        # Register the copy so `lpm install <addon>` targets it. This needs
        # network on first use while lpm fetches its repositories.
        lpm lite-xl add "$version" "$LITE_XL_DATA" >/dev/null 2>&1 || true
    fi

    info "lite-xl: installed $version ($BIN_DIR/lite-xl)"
)

install_uv() (
    local arch url tmp
    arch=$(machine_arch) || { err "uv: unsupported architecture"; return 1; }
    if [[ -x $BIN_DIR/uv ]]; then
        info "uv: already installed ($BIN_DIR/uv)"
        return 0
    fi
    url="https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-$arch-unknown-linux-gnu.tar.gz"
    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT
    info "uv: downloading $UV_VERSION"
    fetch_release uv "$arch" "$url" "$tmp/uv.tar.gz" || return 1
    tar -xzf "$tmp/uv.tar.gz" -C "$tmp" || { err "uv: extract failed"; return 1; }
    mkdir -p "$BIN_DIR" || return 1
    install -m 0755 "$tmp/uv-$arch-unknown-linux-gnu/uv" "$BIN_DIR/uv" ||
        { err "uv: could not write $BIN_DIR/uv"; return 1; }
    install -m 0755 "$tmp/uv-$arch-unknown-linux-gnu/uvx" "$BIN_DIR/uvx" ||
        { err "uv: could not write $BIN_DIR/uvx"; return 1; }
    info "uv: installed $UV_VERSION ($BIN_DIR/uv)"
)

install_bun() (
    local arch url tmp
    case "$(uname -m)" in
        x86_64) arch=x64 ;;
        aarch64) arch=aarch64 ;;
        *) err "bun: unsupported architecture"; return 1 ;;
    esac
    if [[ -x $BIN_DIR/bun ]]; then
        info "bun: already installed ($BIN_DIR/bun)"
        return 0
    fi
    if ! have unzip; then
        err "bun: unzip is required"
        return 1
    fi
    url="https://github.com/oven-sh/bun/releases/download/bun-v$BUN_VERSION/bun-linux-$arch.zip"
    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT
    info "bun: downloading $BUN_VERSION"
    fetch_release bun "$(machine_arch)" "$url" "$tmp/bun.zip" || return 1
    unzip -q -o "$tmp/bun.zip" -d "$tmp" || { err "bun: extract failed"; return 1; }
    mkdir -p "$BIN_DIR" || return 1
    install -m 0755 "$tmp/bun-linux-$arch/bun" "$BIN_DIR/bun" ||
        { err "bun: could not write $BIN_DIR/bun"; return 1; }
    info "bun: installed $BUN_VERSION ($BIN_DIR/bun)"
)

install_luaver() (
    local dir="$INSTALL_ROOT/share/luaver" tmp
    if [[ -x $BIN_DIR/luaver ]]; then
        info "luaver: already installed ($BIN_DIR/luaver)"
        return 0
    fi
    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT

    info "luaver: downloading $LUAVER_VERSION"
    fetch_verified "$LUAVER_URL/luaver" "$LUAVER_SHA256" "$tmp/luaver" || return 1
    fetch_verified "$LUAVER_URL/completions/luaver.bash" "$LUAVER_COMPLETIONS_SHA256" \
        "$tmp/luaver.bash" || return 1

    install -d -m 0755 "$dir/completions" || return 1
    install -m 0644 "$tmp/luaver" "$dir/luaver" ||
        { err "luaver: could not write $dir/luaver"; return 1; }
    install -m 0644 "$tmp/luaver.bash" "$dir/completions/luaver.bash" ||
        { err "luaver: could not write $dir/completions/luaver.bash"; return 1; }

    # luaver needs to be sourced to set PATH and completions, so the command in
    # ~/.local/bin sources the installed copy and forwards its arguments.
    mkdir -p "$BIN_DIR" || return 1
    cat >"$BIN_DIR/luaver" <<EOF || { err "luaver: could not write $BIN_DIR/luaver"; return 1; }
#!/usr/bin/env bash
# Written by 'hyperblue install luaver'. Managed file; edits are overwritten.
set -uo pipefail
. "$dir/luaver"
luaver "\$@"
EOF
    chmod 0755 "$BIN_DIR/luaver" || return 1
    info "luaver: installed $LUAVER_VERSION ($BIN_DIR/luaver)"
)
install_deno() (
    local arch url tmp
    arch=$(machine_arch) || { err "deno: unsupported architecture"; return 1; }
    if [[ -x $BIN_DIR/deno ]]; then
        info "deno: already installed ($BIN_DIR/deno)"
        return 0
    fi
    if ! have unzip; then
        err "deno: unzip is required"
        return 1
    fi
    url="https://github.com/denoland/deno/releases/download/v$DENO_VERSION/deno-$arch-unknown-linux-gnu.zip"
    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT
    info "deno: downloading $DENO_VERSION"
    fetch_release deno "$arch" "$url" "$tmp/deno.zip" || return 1
    unzip -q -o "$tmp/deno.zip" -d "$tmp" || { err "deno: extract failed"; return 1; }
    mkdir -p "$BIN_DIR" || return 1
    install -m 0755 "$tmp/deno" "$BIN_DIR/deno" ||
        { err "deno: could not write $BIN_DIR/deno"; return 1; }
    info "deno: installed $DENO_VERSION ($BIN_DIR/deno)"
)

install_fnm() (
    local arch url tmp
    case "$(uname -m)" in
        x86_64) arch=linux ;;
        aarch64) arch=arm64 ;;
        *) err "fnm: unsupported architecture"; return 1 ;;
    esac
    if [[ -x $BIN_DIR/fnm ]]; then
        info "fnm: already installed ($BIN_DIR/fnm)"
        return 0
    fi
    if ! have unzip; then
        err "fnm: unzip is required"
        return 1
    fi
    url="https://github.com/Schniz/fnm/releases/download/v$FNM_VERSION/fnm-$arch.zip"
    tmp=$(mktemp -d)
    trap 'rm -rf "${tmp:-}"' EXIT
    info "fnm: downloading $FNM_VERSION"
    fetch_release fnm "$(machine_arch)" "$url" "$tmp/fnm.zip" || return 1
    unzip -q -o "$tmp/fnm.zip" -d "$tmp" || { err "fnm: extract failed"; return 1; }
    mkdir -p "$BIN_DIR" || return 1
    install -m 0755 "$tmp/fnm" "$BIN_DIR/fnm" ||
        { err "fnm: could not write $BIN_DIR/fnm"; return 1; }
    info "fnm: installed $FNM_VERSION ($BIN_DIR/fnm)"
)

install_pyenv() (
    local dir="$INSTALL_ROOT/share/pyenv"
    if [[ -x $BIN_DIR/pyenv && -d $dir/plugins ]]; then
        info "pyenv: already installed ($dir)"
        return 0
    fi
    if ! have git; then
        err "pyenv: git is required"
        return 1
    fi

    info "pyenv: cloning $PYENV_VERSION"
    rm -rf "$dir"
    if ! git -c advice.detachedHead=false clone -q --depth 1 --branch "$PYENV_VERSION" \
        https://github.com/pyenv/pyenv "$dir"; then
        err "pyenv: clone failed"
        return 1
    fi
    if ! git clone -q --depth 1 \
        https://github.com/pyenv/pyenv-virtualenv "$dir/plugins/pyenv-virtualenv"; then
        warn "pyenv: pyenv-virtualenv clone failed; pyenv itself still works"
    fi

    # pyenv's `pyenv` is a shell function only after eval'ing init, so the
    # command in ~/.local/bin forwards to the real bin.
    mkdir -p "$BIN_DIR" || return 1
    cat >"$BIN_DIR/pyenv" <<EOF || { err "pyenv: could not write $BIN_DIR/pyenv"; return 1; }
#!/usr/bin/env bash
# Written by 'hyperblue install pyenv'. Managed file; edits are overwritten.
set -uo pipefail
export PYENV_ROOT="$dir"
exec "$dir/bin/pyenv" "\$@"
EOF
    chmod 0755 "$BIN_DIR/pyenv" || return 1
    info "pyenv: installed $PYENV_VERSION ($BIN_DIR/pyenv)"
)

TOOLS="lite-xl uv bun deno fnm pyenv luaver"

install_tool() {
    case $1 in
        lite-xl|litexl|lite_xl) install_lite_xl ;;
        uv) install_uv ;;
        bun) install_bun ;;
        deno) install_deno ;;
        fnm) install_fnm ;;
        pyenv) install_pyenv ;;
        luaver) install_luaver ;;
        *)
            err "unknown tool: $1 (available: $TOOLS)"
            return 2
            ;;
    esac
}

cmd_install() {
    local tool rc=0 requested=()

    while (($#)); do
        case $1 in
            --list)
                for tool in $TOOLS; do info "$tool"; done
                return 0
                ;;
            -h|--help)
                usage
                return 0
                ;;
            -*)
                err "unknown option: $1"
                return 2
                ;;
            *) requested+=("$1") ;;
        esac
        shift
    done

    ((${#requested[@]})) || read -ra requested <<<"$TOOLS"

    mkdir -p "$BIN_DIR" || return 1

    for tool in "${requested[@]}"; do
        info "${BOLD}==> $tool${NORMAL}"
        # Every installer downloads, so check once per tool rather than
        # failing the whole run on a transient outage.
        if ! network_available; then
            err "$tool: no network connectivity"
            rc=1
            continue
        fi
        install_tool "$tool" || rc=1
    done

    if case ":$PATH:" in *":$BIN_DIR:"*) true ;; *) false ;; esac; then
        :
    else
        warn "$BIN_DIR is not on PATH in this shell; start a new login shell."
    fi

    return "$rc"
}

cmd_status() {
    info "${BOLD}Hyperblue status${NORMAL}"
    info "  image version : $(image_version)"
    info "  cli version   : $CLI_VERSION"
    info "  shell         : noctalia"

    if network_available; then
        info "  network       : available"
    else
        info "  network       : unavailable"
    fi

    if [[ -f $COMPLETE_MARKER ]]; then
        info "  first-run     : complete"
    else
        info "  first-run     : pending (run 'hyperblue setup')"
    fi

    info "  waydroid      : $(if rpm -q waydroid >/dev/null 2>&1; then echo installed; else echo 'not installed'; fi)"

    info "  steps ($STEP_DIR):"
    local step found=0
    while IFS= read -r step; do
        [[ -n $step ]] || continue
        found=1
        local state status recorded
        state="$(step_state "$step")"
        if [[ -z $state ]]; then
            info "    - $step"
        else
            read -r status recorded _ <<<"$state"
            info "    - $step: $status (image $recorded)"
        fi
    done < <(list_steps)
    ((found)) || info "    (none)"
}

cmd_version() {
    info "hyperblue $CLI_VERSION (image $(image_version))"
}

main() {
    local cmd=${1:-help}
    (($#)) && shift
    case $cmd in
        setup) cmd_setup "$@" ;;
        update) cmd_update "$@" ;;
        fix) cmd_fix "$@" ;;
        install) cmd_install "$@" ;;
        status) cmd_status "$@" ;;
        version|--version|-V) cmd_version ;;
        help|--help|-h) usage ;;
        *)
            err "unknown command: $cmd"
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
