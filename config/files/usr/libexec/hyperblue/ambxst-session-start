#!/usr/bin/env bash
# Integrate the Ambxst shell into this user's Hyprland configuration and start
# it. Idempotent: safe to run at every Hyprland start and from `hyperblue setup`.
#
# Usage:
#   ambxst-session-start                  integrate (if needed) and start the shell
#   ambxst-session-start --integrate-only integrate only, do not start anything

set -uo pipefail

integrate_only=0
case ${1:-} in
    --integrate-only) integrate_only=1 ;;
    -h|--help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
config_file="$config_dir/hyprland.conf"

ensure_session_services() {
    # Ambxst rewrites everything above its OVERRIDES marker, so the session
    # services Hyperblue adds live below it, tagged so they are added only once.
    [[ -f $config_file ]] || return 0
    grep -q '^# hyperblue:session-services' "$config_file" && return 0
    {
        printf '\n# hyperblue:session-services\n'
        printf '# Managed by Hyperblue. Keep these lines below the OVERRIDES marker.\n'
        printf 'exec-once = systemctl --user start hyprpolkitagent.service\n'
        printf 'exec-once = systemctl --user start xdg-desktop-portal-hyprland.service\n'
    } >>"$config_file"
}

integrate() {
    if ! command -v ambxst >/dev/null 2>&1; then
        echo "ambxst is not installed; skipping shell integration"
        return 0
    fi

    mkdir -p "$config_dir"

    if ! grep -qi 'ambxst' "$config_file" 2>/dev/null; then
        # Ambxst writes the source line itself (and generates the shell config).
        # Feeding it /dev/null keeps it non-interactive; if that fails we fall
        # back to the block Ambxst documents, so the shell still starts.
        ambxst install hyprland </dev/null >/dev/null 2>&1 || true

        if ! grep -qi 'ambxst' "$config_file" 2>/dev/null; then
            {
                printf '\n# Ambxst\n'
                printf 'source = ~/.local/share/ambxst/hyprland.conf\n'
                printf '\n# OVERRIDES\n'
                printf '# Anything that should override Ambxst belongs below this line.\n'
            } >>"$config_file"
        fi
    fi

    ensure_session_services
}

start_shell() {
    command -v ambxst >/dev/null 2>&1 || return 0
    pgrep -x ambxst >/dev/null 2>&1 && return 0
    pgrep -x quickshell >/dev/null 2>&1 && return 0
    setsid ambxst >/dev/null 2>&1 </dev/null &
}

integrate
((integrate_only)) || start_shell
